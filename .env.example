# Example runtime values for the backend application.
# Do not commit real .env files or production secrets.

NODE_ENV=development
PORT=5000

DB_MODE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_booking
DB_USER=admin
DB_PASSWORD=change-me

JWT_SECRET=replace-with-local-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=http://localhost:3000

EMAIL_PROVIDER=ethereal
AWS_REGION=us-east-1
AWS_SES_REGION=us-east-1
EMAIL_FROM=no-reply@example.com

PATIENT_RESET_OTP_LENGTH=6
PATIENT_RESET_OTP_TTL_SECONDS=300
PATIENT_RESET_OTP_RESEND_SECONDS=60
PATIENT_RESET_OTP_PREVIEW=true
